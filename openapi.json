{
  "openapi": "3.0.3",
  "info": {
    "title": "devlake-synth API",
    "version": "1.0.0",
    "description": "In-memory CRUD API for items. Data is lost on restart."
  },
  "servers": [
    { "url": "/" }
  ],
  "tags": [
    { "name": "system", "description": "Service status and welcome message" },
    { "name": "items", "description": "Item CRUD and pagination" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["system"],
        "operationId": "getWelcome",
        "summary": "Welcome message",
        "responses": {
          "200": {
            "description": "Welcome message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": { "type": "string", "example": "Welcome to DevLake" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["system"],
        "operationId": "getHealth",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["system"],
        "operationId": "getOpenApiSpec",
        "summary": "This OpenAPI specification",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.0 document describing this API",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "tags": ["items"],
        "operationId": "listItems",
        "summary": "List items",
        "description": "Returns a page of items. Response headers: `X-Total-Count` gives the total number of items, and `Link` carries RFC 8288 `next`/`prev` relations when a further page exists in that direction.",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of items to skip.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items to return. Values above 100 are capped at 100.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of items",
            "headers": {
              "X-Total-Count": {
                "description": "Total number of items, regardless of the page requested.",
                "schema": { "type": "integer" }
              },
              "Link": {
                "description": "RFC 8288 `next` and `prev` links. Omitted when everything fits on one page.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemList" }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "post": {
        "tags": ["items"],
        "operationId": "createItem",
        "summary": "Create an item",
        "description": "Unknown fields and any client-supplied `id` are ignored.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created",
            "headers": {
              "Location": {
                "description": "Path of the new item, e.g. `/items/1`.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/items/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/ItemId" }
      ],
      "get": {
        "tags": ["items"],
        "operationId": "getItem",
        "summary": "Get one item",
        "responses": {
          "200": {
            "description": "The item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["items"],
        "operationId": "replaceItem",
        "summary": "Replace an item",
        "description": "Replaces `name` and `description`. An omitted `description` is cleared.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item replaced",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["items"],
        "operationId": "updateItem",
        "summary": "Update an item",
        "description": "Updates only the fields provided. At least one of `name` or `description` is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemPatch" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["items"],
        "operationId": "deleteItem",
        "summary": "Delete an item",
        "responses": {
          "204": { "description": "Item deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ItemId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Item id. Must be a positive integer.",
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "example": 1 },
          "name": { "type": "string", "example": "Widget" },
          "description": { "type": "string", "example": "blue" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ItemInput": {
        "type": "object",
        "required": ["name"],
        "description": "Leading and trailing whitespace is trimmed from `name`. A `name` that is blank after trimming is rejected.",
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "Widget" },
          "description": { "type": "string", "example": "blue" }
        }
      },
      "ItemPatch": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one of `name` or `description` must be present.",
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "Widget" },
          "description": { "type": "string", "example": "blue" }
        }
      },
      "ItemList": {
        "type": "object",
        "required": ["total", "items"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Item" }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "Item not found" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request: malformed JSON, invalid id or pagination parameter, or failed validation",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "No item with the given id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
