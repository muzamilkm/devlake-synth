{
  "openapi": "3.0.3",
  "info": {
    "title": "DevLake Synth API",
    "version": "1.0.0",
    "description": "In-memory CRUD API for items. Data is lost when the server restarts."
  },
  "servers": [
    { "url": "/" }
  ],
  "tags": [
    { "name": "System", "description": "Service status and metadata" },
    { "name": "Items", "description": "Create, read, update and delete items" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Welcome message",
        "operationId": "getWelcome",
        "responses": {
          "200": {
            "description": "Welcome message",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Welcome" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["System"],
        "summary": "OpenAPI specification",
        "description": "Returns this document.",
        "operationId": "getOpenApiSpec",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "tags": ["Items"],
        "summary": "List items",
        "description": "Returns a page of items. `limit` defaults to 20 and values above 100 are capped at 100. The `Link` header is only present when there is a next or previous page.",
        "operationId": "listItems",
        "parameters": [
          { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "A page of items",
            "headers": {
              "X-Total-Count": {
                "description": "Total number of items, regardless of the page requested",
                "schema": { "type": "integer", "minimum": 0 }
              },
              "Link": {
                "description": "RFC 8288 `next` and/or `prev` links that keep the same `limit`",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemList" }
              }
            }
          },
          "400": {
            "description": "`offset` is not a non-negative integer or `limit` is not a positive integer",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Items"],
        "summary": "Create an item",
        "description": "Unknown fields and a client-supplied `id` are ignored. `name` is trimmed before it is stored.",
        "operationId": "createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created",
            "headers": {
              "Location": {
                "description": "URL of the new item",
                "schema": { "type": "string", "example": "/items/1" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/items/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/ItemId" }
      ],
      "get": {
        "tags": ["Items"],
        "summary": "Get an item",
        "operationId": "getItem",
        "responses": {
          "200": {
            "description": "The item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidItemId" },
          "404": { "$ref": "#/components/responses/ItemNotFound" }
        }
      },
      "put": {
        "tags": ["Items"],
        "summary": "Replace an item",
        "description": "Replaces `name` and `description`. Omitting `description` clears it. `id` and `createdAt` are kept.",
        "operationId": "replaceItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The replaced item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/ItemNotFound" }
        }
      },
      "patch": {
        "tags": ["Items"],
        "summary": "Update an item",
        "description": "Updates only the fields provided. At least one of `name` or `description` is required.",
        "operationId": "updateItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemPatch" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/ItemNotFound" }
        }
      },
      "delete": {
        "tags": ["Items"],
        "summary": "Delete an item",
        "operationId": "deleteItem",
        "responses": {
          "204": { "description": "Item deleted" },
          "400": { "$ref": "#/components/responses/InvalidItemId" },
          "404": { "$ref": "#/components/responses/ItemNotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Number of items to skip",
        "required": false,
        "schema": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Page size. Defaults to 20 and is capped at 100.",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 20 }
      },
      "ItemId": {
        "name": "id",
        "in": "path",
        "description": "Item id",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid JSON body or failed validation",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "InvalidItemId": {
        "description": "The id is not a positive integer",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "ItemNotFound": {
        "description": "No item with that id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Welcome": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "Welcome to DevLake" }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "example": "ok" }
        }
      },
      "Item": {
        "type": "object",
        "required": ["id", "name", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "example": 1 },
          "name": { "type": "string", "example": "Widget" },
          "description": { "type": "string", "example": "blue" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ItemInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Must contain at least one non-whitespace character" },
          "description": { "type": "string" }
        }
      },
      "ItemPatch": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Must contain at least one non-whitespace character" },
          "description": { "type": "string" }
        }
      },
      "ItemList": {
        "type": "object",
        "required": ["total", "items"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Item" }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "Item not found" }
        }
      }
    }
  }
}
